{
  "name": "newnewmusic-backend",
  "version": "1.0.0",
  "description": "Node.js backend for NewNewMusic application",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "NODE_ENV=test jest",
