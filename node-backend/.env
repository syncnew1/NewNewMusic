# 环境配置
NODE_ENV=development

# 服务器配置
PORT=8080

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/newnewmusic

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# 文件上传配置
UPLOAD_PATH=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=audio/mpeg,audio/wav,audio/mp3,image/jpeg,image/png,image/jpg

# 应用配置
BASE_URL=http://localhost:8080

# 速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS配置
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:3001,http://localhost:5173