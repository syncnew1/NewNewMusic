# 测试环境配置
NODE_ENV=test

# 服务器配置
PORT=3001
HOST=localhost

# 数据库配置
MONGODB_URI=mongodb://localhost:27017/newnewmusic_test

# JWT配置
JWT_SECRET=test-jwt-secret-key-for-testing-only-do-not-use-in-production
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-testing-only-do-not-use-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# 文件上传配置
MAX_FILE_SIZE=50MB
UPLOAD_PATH=./uploads

# 基础URL
BASE_URL=http://localhost:3001

# 速率限制配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# 允许的来源
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174